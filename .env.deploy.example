# Copy to ignored .env.deploy. Real values belong only on the Docker host.
SERVER_NAME=app.example.invalid
PUBLIC_ORIGIN=https://app.example.invalid
MONGO_URI=REPLACE_WITH_PRIVATE_MONGODB_URI
# Paths resolve relative to deploy/compose.yaml. Absolute paths also work.
BACKEND_CONTEXT=../../EOApp-Cloud_Backend
TLS_CERT_DIR=./tls
# Set to the host group allowed to read TLS keys; files must not be world-readable.
TLS_READ_GID=101
# Loopback defaults are for rehearsal. A public host needs explicitly chosen binds.
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
RELEASE_TAG=local
SMTP_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_ROTATED_SMTP_PASSWORD
SMTP_FROM=inquiries@example.invalid
SMTP_TO=approved-team@example.invalid
STAFF_ENABLED=false
